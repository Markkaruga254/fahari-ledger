+def test_send_sms_succeeds_first_try_without_retrying(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        sender.at_sms,
+        "send",
+        lambda message, recipients, sender_id: calls.append(1) or {"ok": True},
+    )
+
+    result = sender.send_sms("+254700000000", "hello")
+
+    assert result == {"ok": True}
+    assert len(calls) == 1
