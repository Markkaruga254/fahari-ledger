# Africa's Talking credentials
# USSD/SMS can use the sandbox account. Voice sandbox is currently unavailable;
# for voice testing request a Voice Test Number in the AT dashboard.
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key
AT_SHORTCODE=*384*41309#
AT_SENDER_ID=FahariLedger

# Database
# Local Docker Compose (default, works as-is):
DATABASE_URL=postgresql://fahari:fahari@db:5432/fahari_ledger
# Production (Render): paste the Internal Database URL from the dashboard.
# `postgres://...` and `postgresql://...` schemes are both accepted.

# Listen port. Honor $PORT when the platform provides it (Render requires
# this); default 8000 keeps plain `docker run` identical to before.
# The Dockerfile reads ${PORT:-8000}, so no .env entry is needed locally.
PORT=8000

# ASR (Voice logging demo path)
ASR_PROVIDER=whisper
ASR_API_KEY=your_asr_api_key

# Public HTTPS base URL used by Africa's Talking for the voice recording callback.
# Local dev via tunnel: https://<ngrok-host> (ngrok remains fine for testing).
# Production: https://<your-render-service>.onrender.com — required, otherwise
# AT cannot reach /voice/recording. The /ussd callback needs no such setting;
# it is configured directly in the AT dashboard.
PUBLIC_BASE_URL=

# Overstock nudge heuristic
OVERSTOCK_HOUR_THRESHOLD=15
OVERSTOCK_STOCK_RATIO=0.4

# Logging verbosity (DEBUG, INFO, WARNING, ERROR). Not read by pydantic
# Settings — picked up directly from the environment by app/utils/logging.py.
LOG_LEVEL=INFO
